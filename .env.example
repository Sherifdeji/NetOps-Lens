# Copy to `.env` and fill in. Never commit `.env` to Git.
# Blank values fall back to the documented defaults; only set what you need.
# API key for the Meta Model API. Absent/blank means no live API calls:
# unit tests and offline work never require it. Never print or log this value.
META_API_KEY=
# Base URL for the Meta Model API. Chat completions live under
# <META_API_BASE>/chat/completions .
META_API_BASE=https://api.meta.ai/v1
# Chat model identifier used by the smoke test and Stage B investigation.
META_MODEL=muse-spark-1.3
# Candidate submission variant: "tool" (submit_candidate_patch tool call)
# or "structured_output" (validated JSON-schema response). Set from the
# Phase 0 smoke-test result; "tool" until the API confirms otherwise.
CANDIDATE_SUBMISSION_VARIANT=tool
BATFISH_HOST=localhost
BATFISH_NETWORK=netops-lens-lab
AGENT_MAX_TOOL_CALLS=8
MAX_CANDIDATES=3
MAX_PATCH_RETRIES=1
